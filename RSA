def Powermod(a, b, n):
    b2, z = format(b, "08b"), 1
    for bit in b2:
        if bit == "1":
            z = ((z**2) * a) % n
        else:
            z = (z**2) % n
    return z


def RSA(Text, Key, n, k=3):
    if isinstance(Text, list):
        M = Text
    else:
        U_Text = "".join(Text.split())
        M = [U_Text[i : i + k] for i in range(0, len(U_Text), k)]
    c = []
    for m in M:
        c.append(str(Powermod(int(m), Key, n)))
    return c


Key = [79, 1019]
n = 3337

Text = input()
c = RSA(Text, Key[0], n, 3)
print(" ".join(c))

