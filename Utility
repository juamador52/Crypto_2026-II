import numpy as np

def EEA(a, b):
    if b == 0:
        return (a, 1, 0)
    q = a // b
    d0, x0, y0 = EEA(b, a % b)
    d, x, y = d0, y0, x0 - q * y0
    return (d, x, y)

def mod_inverse(a, m):
    a = a % m
    d, x, y = EEA(a, m)
    if d != 1:
        raise ValueError("No existe matriz inversa.")
    return x % m

def inverse_matrix_2x2(matrix, mod):
    matrix = np.array(matrix, dtype=int)
    det = (matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]) % mod
    det_inv = mod_inverse(det, mod)
    
    adj = np.array([
        [matrix[1][1], -matrix[0][1]],
        [-matrix[1][0], matrix[0][0]]
    ])
    
    return (det_inv * adj) % mod

def permute_text(text, indices):
    n = len(indices)
    if len(text) % n != 0:
        text += "0" * (n - (len(text) % n))
    
    result = ""
    for i in range(0, len(text), n):
        block = text[i:i+n]
        result += "".join(block[idx - 1] for idx in indices)
        
    return result


